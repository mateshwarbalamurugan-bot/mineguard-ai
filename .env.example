# Port for Express API server
PORT=3001

# JWT Secret for signing authentication tokens
JWT_SECRET=notes-board-jwt-secret-key-super-secure

# Database file path
DB_PATH=./backend/notes.db

# AI Service Configuration
# Provider: mock | gemini | openai | anthropic (default: mock)
AI_PROVIDER=mock
AI_API_KEY=your_api_key_here
AI_MODEL=mock-model

# Real-time Collaboration (Yjs + WebSockets at /ws)
# Enable or disable real-time collaboration (true | false, default: true)
COLLAB_ENABLED=true

